{
  "name": "vsc-sc2-map-launcher",
  "displayName": "StarCraft 2 Map Launcher",
  "description": "Launch StarCraft II maps directly from VS Code",
  "version": "0.5.0",
  "publisher": "Playbitstudios",
  "icon": "readme-pic/sc2editoricon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sc2.launch",
        "title": "SC2: Launch Map",
        "icon": "$(run)"
      }
    ],
    "debuggers": [
      {
        "type": "sc2",
        "label": "SC2 Launcher",
        "initialConfigurations": [
          {
            "name": "SC2: Launch Map",
            "type": "sc2",
            "request": "launch",
            "triggerDebug": false,
            "showErrors": false
          }
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "triggerDebug": {
                "type": "boolean",
                "default": false,
                "description": "Open the in-game trigger debugger window on launch."
              },
              "showErrors": {
                "type": "boolean",
                "default": false,
                "description": "Capture SC2 output and stream it to the SC2 Output Channel in VS Code."
              },
              "preload": {
                "type": "boolean",
                "default": true,
                "description": "Preload map assets before launching (-preload 1)."
              },
              "noUserCheats": {
                "type": "boolean",
                "default": true,
                "description": "Disable in-game cheat commands (-NoUserCheats)."
              },
              "meleeMod": {
                "type": "string",
                "default": "Void",
                "description": "Game mode/mod to use, e.g. Void for LotV melee (-meleeMod)."
              },
              "difficulty": {
                "type": "integer",
                "default": 2,
                "minimum": 0,
                "maximum": 3,
                "description": "AI difficulty: 0=VeryEasy, 1=Easy, 2=Medium, 3=Hard (-difficulty)."
              },
              "speed": {
                "type": "integer",
                "default": 2,
                "minimum": 0,
                "maximum": 4,
                "description": "Game speed: 0=Slower, 1=Slow, 2=Normal, 3=Fast, 4=Faster (-speed)."
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "SC2 Map Tools",
      "properties": {
        "sc2.installDir": {
          "type": "string",
          "default": "",
          "description": "Path to your StarCraft II installation folder (the one that contains Support64\\SC2Switcher_x64.exe). Example: C:\\Program Files (x86)\\StarCraft II"
        },
        "sc2.mapPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the .SC2Map folder. Leave empty to auto-detect from the workspace (first folder ending in .SC2Map)."
        }
      }
    }
  },
  "packageManager": "yarn@1.22.17",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  }
}
