{
  "name": "vsc-sc2",
  "displayName": "SC2 Map Tools",
  "description": "Launch StarCraft II maps directly from VS Code",
  "version": "0.1.0",
  "publisher": "Playbitstudios",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sc2.launch",
        "title": "SC2: Launch Map",
        "icon": "$(run)"
      }
    ],
    "debuggers": [
      {
        "type": "sc2",
        "label": "SC2 Launcher",
        "initialConfigurations": [
          {
            "name": "SC2: Launch Map",
            "type": "sc2",
            "request": "launch"
          }
        ]
      }
    ],
    "configuration": {
      "title": "SC2 Map Tools",
      "properties": {
        "sc2.installDir": {
          "type": "string",
          "default": "",
          "description": "Path to your StarCraft II installation folder (the one that contains Support64\\SC2Switcher_x64.exe). Example: C:\\Program Files (x86)\\StarCraft II"
        },
        "sc2.mapPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the .SC2Map folder. Leave empty to auto-detect from the workspace (first folder ending in .SC2Map)."
        }
      }
    }
  },
  "packageManager": "yarn@1.22.17",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  }
}
